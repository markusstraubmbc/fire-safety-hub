# Phusion Passenger deaktivieren (Plesk-Hosting)
#
# resqio.de laeuft auf einem Plesk-Server (nginx -> Apache) mit aktiviertem
# Phusion Passenger. Passenger faengt dort JEDEN Request ab, der nicht direkt
# auf eine existierende Datei zeigt, und versucht eine Node-/Ruby-Anwendung zu
# starten. Da diese Seite ein rein statischer Vite-Build ist, gibt es keine
# solche Anwendung -> Passenger antwortet mit
# "500 Web application could not be started".
#
# Folge: /, /index.html und alle Assets lieferten 200, aber saemtliche Routen
# ohne Dateiendung (/kreis, /modul/*, /wissen/*) lieferten 500 – also 48 von 49
# Seiten aus der sitemap.xml. Die mod_rewrite-Regeln weiter unten kamen gar
# nicht erst zum Zug, weil Passenger vorher greift.
#
# Mit "PassengerEnabled off" uebernimmt wieder mod_rewrite: Verzeichnisse mit
# prerenderter index.html werden direkt ausgeliefert, alles andere faellt auf
# den SPA-Fallback zurueck.
#
# Der <IfModule>-Guard ist wichtig: Auf Servern ohne Passenger (z. B. Vercel
# oder lokales Apache) waere die Direktive sonst unbekannt und wuerde ihrerseits
# einen 500er ausloesen.
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>

DirectoryIndex index.html

# Kein 301 von /kreis auf /kreis/
#
# Standardmaessig schickt mod_dir (DirectorySlash) fuer jedes Verzeichnis ohne
# Trailing Slash einen 301 auf die Variante mit Slash. Genau die URLs ohne
# Slash stehen aber in sitemap.xml und in allen Canonicals – Google bekam also
# fuer jede Seite erst einen Redirect und landete dann auf einer URL, die per
# Canonical wieder zurueckzeigt. Mit "DirectorySlash Off" liefert die
# Rewrite-Regel weiter unten die prerenderte index.html direkt mit 200 aus.
# Ungefaehrlich, weil Options -Indexes gesetzt ist und die Seite ausschliesslich
# absolute Asset-Pfade (/assets/...) verwendet.
DirectorySlash Off

# Custom error pages
# 404.html wird von scripts/prerender.mjs erzeugt und traegt noindex.
ErrorDocument 404 /404.html
ErrorDocument 500 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> non-www
  # www.resqio.de lieferte bisher 200 mit identischem Inhalt. Der Canonical
  # zeigte zwar korrekt auf die Variante ohne www, ein 301 ist aber das
  # eindeutigere Signal und buendelt Linkjuice auf eine Hostvariante.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /modul und /modul/ sind keine echten Seiten (nur Client-Redirects in
  # App.tsx) und werden nicht prerendert -> serverseitig auf die Startseite.
  RewriteRule ^modul/?$ / [R=301,L]

  # Remove trailing slash
  # Bewusst OHNE "!-d": prerenderte Seiten sind Verzeichnisse, und genau fuer
  # die brauchen wir den Redirect, damit /kreis/ und /kreis nicht beide mit 200
  # antworten (Duplicate Content). Kein Loop, weil DirectorySlash off ist.
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Redirect legacy kreis-platform URL to dedicated page
  RewriteRule ^modul/kreis-platform$ /kreis [R=301,L]

  # Route /api/contact to PHP handler (Apache deployments)
  RewriteRule ^api/contact$ /api/contact.php [L]

  # Serve prerendered files if directory with index.html exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ %{REQUEST_URI}/index.html [L]

  # Don't rewrite existing files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # KEIN pauschaler SPA-Fallback mehr.
  #
  # Vorher ging jede unbekannte URL per Rewrite auf /index.html – und zwar mit
  # Status 200. Damit meldete der Server jeden Tippfehler und jeden toten
  # Altlink als gueltige Seite (Soft 404), was Google in der Search Console
  # als "Soft 404" anmeckert und Crawl-Budget verbrennt.
  #
  # Da scripts/prerender.mjs inzwischen JEDE Route als eigenes Verzeichnis mit
  # index.html ausgibt (Startseite, /kreis, alle /modul/*, /wissen + Artikel,
  # /impressum, /datenschutz), greift fuer echte Seiten die Verzeichnisregel
  # weiter oben. Alles andere faellt korrekt auf ErrorDocument 404 -> /404.html
  # mit echtem 404-Status, und React rendert dort die NotFound-Seite.
  #
  # WICHTIG: Neue Routen in src/App.tsx muessen in scripts/prerender.mjs
  # ergaenzt werden – sonst liefern sie 404 statt der Seite.
</IfModule>

# Prevent directory listings
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML: no cache (crawlers always get fresh content)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Sitemap: short cache
  <FilesMatch "sitemap\.xml$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
